#!/bin/bash
# Version 0.1.0
# TODO:
# * Add initialization/configuration inputs
#
# Requirements:
# * Jira CLI configured
# * jq
# * GNU sed (gsed)
#
# brew tap atlassian/homebrew-acli
# brew install acli
# echo "$JIRA_API_TOKEN" | acli jira auth login --site "jiraent.cms.gov" --email "thomas.dooner@cms.hhs.gov" --token
set -euo pipefail

# CONFIGURATION:
PROJECT="FFS"
REPO_URL="https://github.com/DSACMS/iv-cbv-payroll"
SPRINT_FIELD_NAME="Sprint"

# INITIALIZATION
ME=$(jira me || true)
REPO_ROOT=$(git rev-parse --show-toplevel)
if [ -z "$ME" ]; then
  echo 'Error: Jira CLI not correctly configured. Ensure `jira me` returns successfully and retry.'
  exit 1
fi

# HELPERS
green() {
  local text="$1"
  echo -e "\033[0;32m${text}\033[0m"
}

jira_custom_field_id() {
  local field_name="$1"
  ruby -r yaml -e '
    jira_config = YAML.load_file(File.expand_path("~/.config/.jira/.config.yml"))
    field = jira_config["issue"]["fields"]["custom"].find { |f| f["name"] == "'$field_name'" }

    if field && field["schema"]["datatype"] == "number"
      puts field["key"]
    elsif field && field["schema"]["datatype"] == "array"
      if field["name"] == "'$SPRINT_FIELD_NAME'"
        raise "You need to set \"datatype: number\" for the Sprint field in your ~/.config/.jira/.config.yml"
      else
        puts field["key"]
      end
    else
      raise "Could not find JIRA Custom field: '$field_name'"
    end
  '
}

# TODO: Revisit after https://github.com/ankitpokhrel/jira-cli/pull/661 lands
# jira_issue_update_custom_field() {
